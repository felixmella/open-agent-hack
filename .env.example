# Copy to .env and fill in locally. Never commit .env.
# Keep comments on their own lines: docker --env-file does not strip inline comments.

# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris web UI (user menu, API keys)
ZETARIS_API_KEY=your-zetaris-api-key
# Identifies us to Wikimedia when Zetaris calls its APIs: an app name plus a contact e-mail
ZETARIS_USER_AGENT=FactSyncChile/0.1 (you@example.org)

# Meterless Nightshift (primary AI provider), from the Nightshift Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Runtime
SAMPLE_MODE=false
LOG_LEVEL=INFO
